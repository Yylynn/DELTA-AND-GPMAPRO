DELTA_APP_NAME=DELTA 时空交易终端
DELTA_APP_VERSION=0.1.0
DELTA_ENVIRONMENT=development
DELTA_CORS_ORIGINS=http://localhost:5184,http://127.0.0.1:5184
DELTA_NEWS_ENABLED=true
DELTA_NEWS_CACHE_TTL_SECONDS=900
