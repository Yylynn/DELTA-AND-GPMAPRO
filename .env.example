DELTA_APP_NAME=DELTA 时空交易终端
DELTA_APP_VERSION=0.1.0
DELTA_ENVIRONMENT=development
DELTA_CORS_ORIGINS=http://localhost:5184,http://127.0.0.1:5184
DELTA_NEWS_ENABLED=true
DELTA_NEWS_CACHE_TTL_SECONDS=900
DELTA_NEWS_RSS_TIMEOUT_SECONDS=15
DELTA_NEWS_CNBC_ENABLED=true
DELTA_NEWS_MARKETWATCH_ENABLED=true
DELTA_NEWS_ZH_SENTIMENT_ENABLED=true
DELTA_FINNHUB_API_KEY=
# Optional market-risk radar providers.  Keep actual keys only in .env.
DELTA_TWELVE_DATA_API_KEY=
DELTA_FRED_API_KEY=
# Zero-configuration default. Set to futu only when local OpenD is installed.
DELTA_MARKET_DATA_PROVIDER=yahoo
# SEC asks automated clients to identify an application and contact address.
DELTA_SEC_USER_AGENT=DELTA-Research-Terminal/0.1 your-email@example.com
DELTA_STOCK_POOL_ENABLED=true
