{ GPMAAPRO V1 - save in Futu MyLang as short name GPMAAPRO; this does not replace GPMAPRO }
{ Futu MAI has no DRAWCOLORLINE. IF(...,DRAWNULL) draws each coloured segment. }
E8:=EMA(C,8); E10:=EMA(C,10); E12:=EMA(C,12); E15:=EMA(C,15); E20:=EMA(C,20);
E40:=EMA(C,40); E45:=EMA(C,45); E50:=EMA(C,50); E55:=EMA(C,55); E60:=EMA(C,60);
E8R:IF(E8>E10,E8,DRAWNULL),COLORRED; E8G:IF(E8<=E10,E8,DRAWNULL),COLORGREEN;
E10R:IF(E10>E12,E10,DRAWNULL),COLORRED; E10G:IF(E10<=E12,E10,DRAWNULL),COLORGREEN;
E12R:IF(E12>E15,E12,DRAWNULL),COLORRED; E12G:IF(E12<=E15,E12,DRAWNULL),COLORGREEN;
E15R:IF(E15>E20,E15,DRAWNULL),COLORRED; E15G:IF(E15<=E20,E15,DRAWNULL),COLORGREEN;
E20R:IF(E15>E20,E20,DRAWNULL),COLORRED; E20G:IF(E15<=E20,E20,DRAWNULL),COLORGREEN;
E40R:IF(E40>E45,E40,DRAWNULL),COLORRED; E40G:IF(E40<=E45,E40,DRAWNULL),COLORGREEN;
E45R:IF(E45>E50,E45,DRAWNULL),COLORRED; E45G:IF(E45<=E50,E45,DRAWNULL),COLORGREEN;
E50R:IF(E50>E55,E50,DRAWNULL),COLORRED; E50G:IF(E50<=E55,E50,DRAWNULL),COLORGREEN;
E55R:IF(E55>E60,E55,DRAWNULL),COLORRED; E55G:IF(E55<=E60,E55,DRAWNULL),COLORGREEN;
E60R:IF(E55>E60,E60,DRAWNULL),COLORRED; E60G:IF(E55<=E60,E60,DRAWNULL),COLORGREEN;
E120:MA(C,120),DOTLINE; E250:MA(C,250),DOTLINE;
DIFF:EMA(C,12)-EMA(C,26),COLORRED,LINETHICK2;
DEA:EMA(DIFF,9),COLORBLUE,LINETHICK2;
MACD:(DIFF-DEA)*2,STICK,COLORRED;
TR:=MAX(MAX(H-L,ABS(REF(C,1)-H)),ABS(REF(C,1)-L)); ATR:=MA(TR,26);
DBFZB01:=DEA<0 AND REF(DEA,10)>0 AND MACD>REF(MACD,1) AND REF(MACD,1)<REF(MACD,2) AND C>REF(C,1) AND C>O AND H<E8 AND H<E60 AND REF(L,1)<REF(L,10) AND REF(L,1)=LLV(L,20);
DBFZB02:=C>O AND REF(C,1)<REF(O,1) AND C>(REF(O,1)+REF(C,1))/2 AND MACD>REF(MACD,1) AND DEA<0 AND REF(DEA,10)>0 AND H<E8;
DBFZB03:=L<E120 AND C>E120 AND ABS(C-L)/ABS(C-O)>1.5 AND C<E60;
ZSTPB11:=E8>E10 AND E10>E12 AND E12>E15 AND C>O AND REF(C,1)<E60 AND C>E60;
ZSTPB12:=E20>E60 AND DEA>0 AND REF(DEA,25)<0 AND C>O AND MACD>REF(MACD,1) AND MACD<0 AND NOT(E8>E10);
GSTP:=E20>E60 AND DEA>0 AND C>O AND (O<E20 OR L<E20 OR REF(O,1)<E20) AND C>E20 AND H<>HHV(H,15) AND MACD>REF(MACD,1);
GLTP:=E40>E45 AND E45>E50 AND E50>E55 AND E55>E60 AND E20>E60 AND MACD>REF(MACD,1) AND H<>HHV(H,10) AND C>O AND (O<E60 OR L<E60 OR REF(L,1)<E60) AND C>E60;
TPFZS01:=DEA>0 AND MACD>0 AND MACD<REF(MACD,1) AND O>C AND L>E8 AND ABS(C-O)>MA(ABS(C-O),20)*0.6 AND (C<REF(O,1) OR C<(REF(O,BARSLAST(C>O))+REF(C,BARSLAST(C>O)))/2 OR C<O AND C<REF(O,BARSLAST(C>O AND ABS(C-O)>MA(ABS(C-O),20)))) AND (H=HHV(H,20) OR REF(H,1)=HHV(H,20) OR REF(H,2)=HHV(H,20) OR REF(H,3)=HHV(H,20) OR REF(H,4)=HHV(H,20)) AND REF(DEA,5)>0;
TPFZS02:=H=HHV(H,5) AND MACD<REF(MACD,1) AND DIFF>0 AND REF(DEA,10)<0 AND H=HHV(H,10) AND NOT(E8>E10 AND E10>E12 AND E12>E15 AND E15>E20);
GLDPS11:=((E20<E60 AND E55<E60) OR (E15<E20 AND E20<E60)) AND DEA<0 AND MACD>0 AND O>C AND (C-L)/ABS(C-O)<1.5 AND (O>E60 OR H>E60 OR REF(H,1)>E60) AND C<E60 AND L<>LLV(L,10) AND NOT(E8>E10 AND E10>E12 AND E12>E15 AND E15>E20);
GLDPS12:=E8<E10 AND E10<E12 AND E12<E15 AND E15<E20 AND C<O AND C<E8 AND C<E60 AND C=LLV(C,10) AND NOT(MACD>REF(MACD,1) AND REF(MACD,1)>REF(MACD,2)) AND REF(DEA,10)>0 AND NOT(L<E120 AND C>E120);
GSDP:=E15<E20 AND E20<E60 AND DEA<0 AND MACD>0 AND O>C AND (O>E20 OR H>E20 OR REF(H,1)>E20) AND C<E20 AND L<>LLV(L,10) AND MACD<REF(MACD,1);
GSDPS22:=E12<E15 AND E15<E20 AND E20<E60 AND C<E20 AND REF(H,1)>E20 AND C<REF(C,1) AND DEA<0 AND MACD<REF(MACD,1) AND C<>LLV(C,10);
JC:=CROSS(DIFF,DEA); SC:=CROSSDOWN(DIFF,DEA); N1:=BARSLAST(REF(JC,1))+1; N2:=BARSLAST(REF(SC,1))+1; HH:=VALUEWHEN(SC,HHV(H,N1)); MHD:=VALUEWHEN(SC,HHV(MACD,N1)); LL:=VALUEWHEN(JC,LLV(L,N2)); MLD:=VALUEWHEN(JC,LLV(MACD,N2));
MACD_PEAK:=REF(MACD,1)>REF(MACD,2) AND REF(MACD,1)>MACD; MACD_TROUGH:=REF(MACD,1)<REF(MACD,2) AND REF(MACD,1)<MACD; PP:=VALUEWHEN(MACD_PEAK,REF(H,1)); MMH:=VALUEWHEN(MACD_PEAK,REF(MACD,1)); TT:=VALUEWHEN(MACD_TROUGH,REF(L,1)); MML:=VALUEWHEN(MACD_TROUGH,REF(MACD,1));
TBL1:=MACD_PEAK AND MACD>0 AND PP>HH AND MMH<MHD; BBL1:=MACD_TROUGH AND MACD<0 AND TT<LL AND MML>MLD AND H<E20; KH:=REF(HHV(H,10),2); MACDH:=REF(HHV(MACD,10),2); KL:=REF(LLV(L,10),2); MACDL:=REF(LLV(MACD,10),2); TBL2:=DEA>0 AND H>KH AND MACD<MACDH AND MACD<REF(MACD,1) AND REF(C-O,1)>0 AND L>E8 AND O>C; BBL2:=DEA<0 AND L<KL AND MACD>MACDL AND MACD>REF(MACD,1) AND REF(C-O,1)<0 AND H<E8 AND O<C;
DRAWTEXT(DBFZB01 AND COUNT(DBFZB01,5)<2 AND COUNT(DBFZB02,5)<1,L-0.5*ATR,'B01'); DRAWTEXT(DBFZB02 AND COUNT(DBFZB02,5)<2,L-0.5*ATR,'B02'); DRAWTEXT(DBFZB03 AND COUNT(DBFZB03,5)<2 AND COUNT(DBFZB01,5)<1 AND COUNT(DBFZB02,5)<1,L-0.5*ATR,'B03'); DRAWTEXT(ZSTPB11 AND COUNT(ZSTPB11,5)<2 AND COUNT(GLTP,5)<1,L-0.5*ATR,'B11'); DRAWTEXT(ZSTPB12 AND COUNT(ZSTPB12,5)<2 AND COUNT(GLTP,5)<1,L-0.5*ATR,'B12'); DRAWTEXT(GSTP AND COUNT(GSTP,5)<2 AND COUNT(ZSTPB12,5)<1 AND COUNT(GLTP,5)<1 AND COUNT(ZSTPB11,5)<1,L-0.5*ATR,'B3'); DRAWTEXT(GLTP AND COUNT(GLTP,5)<2 AND COUNT(DBFZB02,5)<1 AND (COUNT(GLTP,5)<2 OR COUNT(GLDPS12,5)>=1),L-0.5*ATR,'B4');
DRAWTEXT(TPFZS01 AND COUNT(TPFZS01,5)<2,L-0.5*ATR,'S01'); DRAWTEXT(TPFZS02 AND COUNT(TPFZS02,5)<2,L-0.5*ATR,'S02'); DRAWTEXT(GLDPS11 AND COUNT(GLDPS11,5)<2 AND COUNT(GLDPS12,6)<1 AND COUNT(GSDP,6)<1,L-0.5*ATR,'S11'); DRAWTEXT(GLDPS12 AND COUNT(GLDPS12,6)<2 AND COUNT(GSDP,5)<1 AND COUNT(GLDPS11,6)<2 AND COUNT(GSDPS22,5)<1,L-0.5*ATR,'S12'); DRAWTEXT(GSDP AND COUNT(GSDP,5)<2 AND COUNT(GLDPS12,5)<1,L-0.5*ATR,'S2'); DRAWTEXT(GSDPS22 AND COUNT(GSDP,5)<1 AND COUNT(GSDPS22,5)<2,L-0.5*ATR,'S22');
DRAWICON(TBL1 AND COUNT(TBL1,5)<2 AND C>E10 AND C<O,C+1.5*ATR,2); DRAWICON(BBL1 AND COUNT(BBL1,5)<2 AND C<E10 AND C>O,C-1.5*ATR,1); DRAWICON(TBL2 AND COUNT(TBL2,5)<2,O+ATR*0.3,5); DRAWICON(BBL2 AND COUNT(BBL2,5)<2,L-ATR*0.3,4);
