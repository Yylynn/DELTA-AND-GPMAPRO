{ GPMA2 TRACE - save as a separate Futu MAI indicator with short name GPMA2TRACE }
{ It exposes the final GPMA2 drawing coordinates to OpenD; it does not replace GPMA2. }
E8:=EMA(C,8); E10:=EMA(C,10); E12:=EMA(C,12); E15:=EMA(C,15); E20:=EMA(C,20);
E40:=EMA(C,40); E45:=EMA(C,45); E50:=EMA(C,50); E55:=EMA(C,55); E60:=EMA(C,60);
EM120:=MA(C,120); EM250:=MA(C,250);
MDIFF:=EMA(C,12)-EMA(C,26); MDEA:=EMA(MDIFF,9); MMACD:=(MDIFF-MDEA)*2;
MTR:=MAX(MAX(H-L,ABS(REF(C,1)-H)),ABS(REF(C,1)-L)); MATR:=MA(MTR,26);
DBFZB01:=MDEA<0 AND REF(MDEA,10)>0 AND MMACD>REF(MMACD,1) AND REF(MMACD,1)<REF(MMACD,2) AND C>REF(C,1) AND C>O AND H<E8 AND H<E60 AND REF(L,1)<REF(L,10) AND REF(L,1)=LLV(L,20);
DBFZB02:=C>O AND REF(C,1)<REF(O,1) AND C>(REF(O,1)+REF(C,1))/2 AND MMACD>REF(MMACD,1) AND MDEA<0 AND REF(MDEA,10)>0 AND H<E8;
DBFZB03:=L<EM120 AND C>EM120 AND ABS(C-L)/ABS(C-O)>1.5 AND C<E60;
ZSTPB11:=E8>E10 AND E10>E12 AND E12>E15 AND C>O AND REF(C,1)<E60 AND C>E60;
ZSTPB12:=E20>E60 AND MDEA>0 AND REF(MDEA,25)<0 AND C>O AND MMACD>REF(MMACD,1) AND MMACD<0 AND NOT(E8>E10);
GSTP:=E20>E60 AND MDEA>0 AND C>O AND (O<E20 OR L<E20 OR REF(O,1)<E20) AND C>E20 AND H<>HHV(H,15) AND MMACD>REF(MMACD,1);
GLTP:=E40>E45 AND E45>E50 AND E50>E55 AND E55>E60 AND E20>E60 AND MMACD>REF(MMACD,1) AND H<>HHV(H,10) AND C>O AND (O<E60 OR L<E60 OR REF(L,1)<E60) AND C>E60;
S01P1:=C<REF(O,1); S01P2:=C<(REF(O,BARSLAST(C>O))+REF(C,BARSLAST(C>O)))/2; S01P3:=C<O AND C<REF(O,BARSLAST(C>O AND ABS(C-O)>MA(ABS(C-O),20))); S01PRICE:=S01P1 OR S01P2 OR S01P3; S01HIGH:=H=HHV(H,20) OR REF(H,1)=HHV(H,20) OR REF(H,2)=HHV(H,20) OR REF(H,3)=HHV(H,20) OR REF(H,4)=HHV(H,20);
TPFZS01:=MDEA>0 AND MMACD>0 AND MMACD<REF(MMACD,1) AND O>C AND L>E8 AND ABS(C-O)>MA(ABS(C-O),20)*0.6 AND S01PRICE AND S01HIGH AND REF(MDEA,5)>0;
TPFZS02:=H=HHV(H,5) AND MMACD<REF(MMACD,1) AND MDIFF>0 AND REF(MDEA,10)<0 AND H=HHV(H,10) AND NOT(E8>E10 AND E10>E12 AND E12>E15 AND E15>E20);
GLDPS11:=((E20<E60 AND E55<E60) OR (E15<E20 AND E20<E60)) AND MDEA<0 AND MMACD>0 AND O>C AND (C-L)/ABS(C-O)<1.5 AND (O>E60 OR H>E60 OR REF(H,1)>E60) AND C<E60 AND L<>LLV(L,10) AND NOT(E8>E10 AND E10>E12 AND E12>E15 AND E15>E20);
GLDPS12:=(E8<E10 AND E10<E12 AND E12<E15 AND E15<E20) AND C<O AND C<E8 AND C<E60 AND C=LLV(C,10) AND NOT(MMACD>REF(MMACD,1) AND REF(MMACD,1)>REF(MMACD,2)) AND REF(MDEA,10)>0 AND NOT(L<EM120 AND C>EM120);
GSDP:=E15<E20 AND E20<E60 AND MDEA<0 AND MMACD>0 AND O>C AND (O>E20 OR H>E20 OR REF(H,1)>E20) AND C<E20 AND L<>LLV(L,10) AND MMACD<REF(MMACD,1);
GSDPS22:=E12<E15 AND E15<E20 AND E20<E60 AND C<E20 AND REF(H,1)>E20 AND C<REF(C,1) AND MDEA<0 AND MMACD<REF(MMACD,1) AND C<>LLV(C,10);
JC:=CROSS(MDIFF,MDEA); DCRS:=REF(MDIFF,1)>=REF(MDEA,1) AND MDIFF<MDEA; N1:=BARSLAST(REF(JC,1))+1; N2:=BARSLAST(REF(DCRS,1))+1;
HH:=VALUEWHEN(DCRS,HHV(H,N1)); MHD:=VALUEWHEN(DCRS,HHV(MMACD,N1)); LL:=VALUEWHEN(JC,LLV(L,N2)); MLD:=VALUEWHEN(JC,LLV(MMACD,N2));
MPEAK:=REF(MMACD,1)>REF(MMACD,2) AND REF(MMACD,1)>MMACD; MTRGH:=REF(MMACD,1)<REF(MMACD,2) AND REF(MMACD,1)<MMACD;
PP:=VALUEWHEN(MPEAK,REF(H,1)); MMH:=VALUEWHEN(MPEAK,REF(MMACD,1)); TT:=VALUEWHEN(MTRGH,REF(L,1)); MML:=VALUEWHEN(MTRGH,REF(MMACD,1));
TBL1:=MPEAK AND MMACD>0 AND PP>HH AND MMH<MHD; BBL1:=MTRGH AND MMACD<0 AND TT<LL AND MML>MLD AND H<E20;
KH:=REF(HHV(H,10),2); MACDH:=REF(HHV(MMACD,10),2); KL:=REF(LLV(L,10),2); MACDL:=REF(LLV(MMACD,10),2);
TBL2:=MDEA>0 AND H>KH AND MMACD<MACDH AND MMACD<REF(MMACD,1) AND REF(C-O,1)>0 AND L>E8 AND O>C;
BBL2:=MDEA<0 AND L<KL AND MMACD>MACDL AND MMACD>REF(MMACD,1) AND REF(C-O,1)<0 AND H<E8 AND O<C;
TRACE_B01:IF(DBFZB01 AND COUNT(DBFZB01,5)<2 AND COUNT(DBFZB02,5)<1,L-0.5*MATR,0),NODRAW;
TRACE_B02:IF(DBFZB02 AND COUNT(DBFZB02,5)<2,L-0.5*MATR,0),NODRAW;
TRACE_B03:IF(DBFZB03 AND COUNT(DBFZB03,5)<2 AND COUNT(DBFZB01,5)<1 AND COUNT(DBFZB02,5)<1,L-0.5*MATR,0),NODRAW;
TRACE_B11:IF(ZSTPB11 AND COUNT(ZSTPB11,5)<2 AND COUNT(GLTP,5)<1,L-0.5*MATR,0),NODRAW;
TRACE_B12:IF(ZSTPB12 AND COUNT(ZSTPB12,5)<2 AND COUNT(GLTP,5)<1,L-0.5*MATR,0),NODRAW;
TRACE_B3:IF(GSTP AND COUNT(GSTP,5)<2 AND COUNT(ZSTPB12,5)<1 AND COUNT(GLTP,5)<1 AND COUNT(ZSTPB11,5)<1,L-0.5*MATR,0),NODRAW;
TRACE_B4:IF(GLTP AND COUNT(GLTP,5)<2 AND COUNT(DBFZB02,5)<1 AND (COUNT(GLTP,5)<2 OR COUNT(GLDPS12,5)>=1),L-0.5*MATR,0),NODRAW;
TRACE_S01:IF(TPFZS01 AND COUNT(TPFZS01,5)<2,H+0.5*MATR,0),NODRAW;
TRACE_S02:IF(TPFZS02 AND COUNT(TPFZS02,5)<2,H+0.5*MATR,0),NODRAW;
TRACE_S11:IF(GLDPS11 AND COUNT(GLDPS11,5)<2 AND COUNT(GLDPS12,6)<1 AND COUNT(GSDP,6)<1,H+0.5*MATR,0),NODRAW;
TRACE_S12:IF(GLDPS12 AND COUNT(GLDPS12,6)<2 AND COUNT(GSDP,5)<1 AND COUNT(GLDPS11,6)<2 AND COUNT(GSDPS22,5)<1,H+0.5*MATR,0),NODRAW;
TRACE_S2:IF(GSDP AND COUNT(GSDP,5)<2 AND COUNT(GLDPS12,5)<1,H+0.5*MATR,0),NODRAW;
TRACE_S22:IF(GSDPS22 AND COUNT(GSDP,5)<1 AND COUNT(GSDPS22,5)<2,H+0.5*MATR,0),NODRAW;
TRACE_TOP1:IF(TBL1 AND COUNT(TBL1,5)<2 AND C>E10 AND C<O,C+1.5*MATR,0),NODRAW;
TRACE_BOT1:IF(BBL1 AND COUNT(BBL1,5)<2 AND C<E10 AND C>O,C-1.5*MATR,0),NODRAW;
TRACE_TOP2:IF(TBL2 AND COUNT(TBL2,5)<2,O+MATR*0.3,0),NODRAW;
TRACE_BOT2:IF(BBL2 AND COUNT(BBL2,5)<2,L-MATR*0.3,0),NODRAW;
